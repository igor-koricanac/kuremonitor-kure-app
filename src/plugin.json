{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Kure Monitor",
  "id": "kuremonitor-kure-app",
  "info": {
    "keywords": ["app", "kubernetes", "monitoring", "ai", "troubleshooting", "kure", "chatbot"],
    "description": "Proactive Kubernetes failure monitoring and intelligent AI assistant for real-time pod troubleshooting and root-cause analysis.",
    "author": {
      "name": "Igor Koricanac",
      "url": "https://igor-koricanac.github.io/kure-monitor/"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [
      {
        "name": "Failure Feed & AI Chatbot Troubleshooting",
        "path": "img/failure_feed.png"
      },
      {
        "name": "Troubleshooting History",
        "path": "img/history_chat.png"
      }
    ],
    "links": [
      {
        "name": "Documentation",
        "url": "https://igor-koricanac.github.io/kure-monitor/"
      },
      {
        "name": "Source Code",
        "url": "https://github.com/igor-koricanac/kure-monitor"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "routes": [
    {
      "path": "proxy/*",
      "url": "{{ .JsonData.apiUrl }}",
      "headers": [
        {
          "name": "X-Service-Token",
          "content": "{{ .SecureJsonData.apiKey }}"
        }
      ]
    }
  ],
  "includes": [
    {
      "type": "page",
      "name": "Kure Dashboard",
      "path": "/a/%PLUGIN_ID%",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  }
}
